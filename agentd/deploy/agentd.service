[Unit]
Description=Agent OS daemon (agentd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agentd
Restart=on-failure
RestartSec=2

User=agentd
Group=agentd

# Config paths (explicit on Pi, env var overrides)
Environment=AGENTD_PLUGINS_TOML=/etc/agentd/plugins.toml
Environment=AGENTD_POLICY_TOML=/etc/agentd/policy.toml
# Workspace on the NVMe (event log + working files live here).
Environment=AGENTD_WORKSPACE=/var/lib/agentd/workspace
Environment=AGENTD_LOG=/var/lib/agentd/events
Environment=AGENTD_UI=/usr/local/share/agentd/ui
# ANTHROPIC_API_KEY lives in /etc/agentd/env — not checked into source
EnvironmentFile=-/etc/agentd/env

# Hardening (relax only as specific tools require it).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agentd
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
