[Unit]
Description=Agent OS daemon (agentd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agentd --config /etc/agentd
Restart=on-failure
RestartSec=2

# Run as a dedicated unprivileged user — the agent can do a lot via tools,
# so the daemon itself should not be root. Tool reach is governed by policy.toml,
# not by process privilege.
User=agentd
Group=agentd

# Workspace on the NVMe (event log + working files live here).
Environment=AGENTD_WORKSPACE=/var/lib/agentd/workspace
Environment=AGENTD_LOG=/var/lib/agentd/events

# Hardening (relax only as specific tools require it).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agentd
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
