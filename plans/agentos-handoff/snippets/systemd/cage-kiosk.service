[Unit]
Description=Agent OS local display (cage kiosk)
# Only meaningful when a KVM/monitor is attached. Harmless headless: cage
# fails to find a DRM device and the unit just stays inactive. The network
# browser frontend works regardless.
After=agentd.service systemd-user-sessions.service
Wants=agentd.service

[Service]
Type=simple
# cage launches exactly one fullscreen app on the seat's DRM/KMS device.
# Here that app is a kiosk browser pointed at the local daemon. The KVM
# display thus renders the SAME web frontend the network browser sees —
# one GUI, two transports.
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --ozone-platform=wayland \
  http://localhost:8787
Restart=on-failure
RestartSec=3

# Needs a seat / DRM master. Run on the console seat.
User=agentos-kiosk
Group=agentos-kiosk
PAMName=login
TTYPath=/dev/tty1

[Install]
WantedBy=graphical.target
