[Unit]
Description=ApexOS GC9A01A face display daemon
After=network.target
Wants=agentd.service

[Service]
Type=simple
User=apexos
Group=apexos
ExecStart=/usr/bin/python3 /home/apexos/ApexOS/deploy/apex-face.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Creates /run/apex-face/ owned by apexos on start
RuntimeDirectory=apex-face
RuntimeDirectoryMode=0755
# lgpio creates its .lgd-nfy* notify FIFO in the process CWD. Default CWD is /
# (not writable by apexos) -> "xCreatePipe: Can't set permissions" -> crash loop.
# Point CWD at the RuntimeDirectory (created above, owned by apexos).
WorkingDirectory=/run/apex-face
# SPI + GPIO access
SupplementaryGroups=gpio spi

[Install]
WantedBy=multi-user.target
